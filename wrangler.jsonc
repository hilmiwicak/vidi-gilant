{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vidi",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-23",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/log", "/log/*"]
	},
	"observability": {
		"enabled": true
	}
}
